# Cloud Functions database configuration.
# This file is regenerated from the root .env (VITE_FIREBASE_DB) by
# scripts/sync-functions-env.mjs before every deploy — do not edit by hand.
#
# FIRESTORE_DATABASE_ID is the single Firestore database the functions
# operate on. No default: a deploy without this value fails loudly.
#
# Switching VITE_FIREBASE_DB in the root .env requires redeploying:
#   firebase deploy --only functions
